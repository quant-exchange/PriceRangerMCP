# PriceRanger MCP examples — environment template.
#
# Copy to .env, fill in the values, then load it:
#
#     cp env.example .env
#     set -a; source .env; set +a
#     python priceranger_mcp_quickstart.py
#
# That `source` line is POSIX-only. On Windows there is no built-in equivalent,
# so set the values directly instead:
#
#     $env:PRICERANGER_MCP_TOKEN = 'paste_it_here'
#
# .env is gitignored; this template is committed and must stay secret-free.
# Nothing here is read automatically — there is no python-dotenv in
# requirements.txt. Loading it is the `set -a; source` line above, or your own
# tooling (direnv, mise, docker --env-file, CI secrets).

# ── Required by all examples ────────────────────────────────────────────────
# Mint at https://priceranger.ai/settings -> MCP access. Shown once, never
# stored by the API. Expires in 30 days; rotate or revoke on that same page.
# There is no anonymous tier.
PRICERANGER_MCP_TOKEN=
# PRICERANGER_TOKEN is a legacy fallback when the canonical value is empty.

# ── Required by priceranger_mcp_eval.py only (the LLM grader) ───────────────
# Set the ONE that matches `provider:` in config.yaml. The tool sweep
# (priceranger_mcp_tool_eval.py) needs neither.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Optional overrides ─────────────────────────────────────────────────────
# PRICERANGER_EVAL_CONFIG=/path/to/config.yaml
# PRICERANGER_MCP_URL=https://priceranger.ai/mcp
# PRICERANGER_EDGE_UNIVERSE_URL=https://priceranger.ai/api/edge-universe
# PRICERANGER_EDGE_UNIVERSE_PATH=/path/to/edge_universe.json
# Set only if you hold the owner's shared admin token, which carries no
# operator identity. A minted user token already identifies its own.
# PRICERANGER_OPERATOR=
